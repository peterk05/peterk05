#!/bin/sh
# Refuse direct pushes to main (for repos where GitHub can't enforce a ruleset).
# Enable with: git config core.hooksPath .githooks
while read -r _local _sha remote_ref _rsha; do
  if [ "$remote_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/master" ]; then
    echo "pre-push: direct pushes to main are blocked; open a PR from a branch." >&2
    exit 1
  fi
done
exit 0
